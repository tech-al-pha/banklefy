# ========================================
# BANKLEFY ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values.
# These are required for the frontend to connect to Supabase.

# Supabase Project ID (used to construct URLs)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Anon/Publishable Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Supabase URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Razorpay public key (frontend)
VITE_RAZORPAY_SITE_KEY="rzp_test_xxx"

# reCAPTCHA v3 site key (frontend)
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"

# Public-facing base URL for canonical/OG tags (production)
VITE_SITE_URL="https://www.banklefy.site"

# Optional: public contact signals for SEO / trust
VITE_PUBLIC_SUPPORT_EMAIL="support@banklefy.site"
VITE_PUBLIC_SECURITY_EMAIL="security@banklefy.site"
VITE_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/banklefy"

# ========================================
# DEPLOYMENT NOTES
# ========================================
# When deploying to Vercel, Netlify, or other static hosts:
# 1. Add these environment variables in your hosting dashboard
# 2. The frontend will use explicit REST URLs to call Supabase Edge Functions
# 3. No internal proxy or platform-specific routing is assumed
#
# Edge Functions run on Supabase infrastructure and have their own env vars
# configured in the Supabase dashboard (not in this file).
# Example for Supabase Function secrets (NEVER expose these to frontend):
# RAZORPAY_KEY_ID="rzp_test_xxx"      # use rzp_live_xxx in production
# RAZORPAY_KEY_SECRET="xxxxxx"       # matching secret for the same mode (test/live)
