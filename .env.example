## Copy this file to `.env` and fill in real values.
## Never commit `.env` (it may contain secrets).

# Frontend checkout key is returned by the secure Razorpay order function.
# Keep this only if you still rely on an older local/dev fallback path.
VITE_RAZORPAY_SITE_KEY="rzp_test_your_key"
VITE_RECAPTCHA_SITE_KEY="your_recaptcha_site_key"
VITE_SITE_URL="https://www.banklefy.site"
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_or_publishable_key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
